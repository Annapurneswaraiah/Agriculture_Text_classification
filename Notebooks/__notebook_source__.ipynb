)



# Convert whole Telugu words into TF-IDF numbers (never splits letters)
tfidf_better = TfidfVectorizer(
    max_features=2000,
    ngram_range=(1, 2),
    sublinear_tf=True,
    token_pattern=r"[\u0C00-\u0C7F]+|[0-9]+",
)


X_train_vec = tfidf_better.fit_transform(X_train)
X_test_vec = tfidf_better.transform(X_test)


