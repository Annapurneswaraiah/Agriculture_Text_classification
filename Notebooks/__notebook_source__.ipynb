import re
import pickle
import pandas as pd

# Load saved artifacts from /kaggle/working/
with open("/kaggle/working/mlp_better_model.pkl", "rb") as f:
    model = pickle.load(f)

with open("/kaggle/working/tfidf_vectorizer.pkl", "rb") as f:
    vectorizer = pickle.load(f)


def clean_telugu_text(text: str) -> str:
    # Matches the cleaning steps from cell [24]
    text = re.sub(r"\S*[A-Za-z]+\S*", " ", str(text))
    text = re.sub(r"\s+", " ", text).strip()
    return text


def predict_queries(queries: list[str]) -> pd.DataFrame:
    cleaned = [clean_telugu_text(q) for q in queries]
    vec = vectorizer.transform(cleaned)
    preds = model.predict(vec)
    probs = model.predict_proba(vec)
    confidences = probs.max(axis=1)

    return pd.DataFrame(
        {
            "Original_Query": queries,
            "Cleaned_Query": cleaned,
            "Predicted_Category": preds,
            "Confidence": confidences.round(4),
        }
    )


